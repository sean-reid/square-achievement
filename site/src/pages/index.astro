---
import Base from "../layouts/Base.astro";
import katex from "katex";
import { results } from "../results";

const k = (tex: string) => katex.renderToString(tex, { throwOnError: true });
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Base
  title="The Square Achievement Game"
  description="Results on the square achievement game: two players claim cells of an n by n grid, and the first to own four corners of an axis-aligned square wins. Papers, machine-checked proofs in Lean, and a playable strategy."
>
  <header class="masthead">
    <h1>The Square Achievement Game</h1>
    <p class="byline">Sean Reid</p>
  </header>

  <p class="lead">
    Two players take turns claiming cells of an
    <span set:html={k("n \\times n")} /> grid. The first to hold all four corners
    of an axis-aligned square wins; a full board with no square is a draw. Erickson
    asked who wins. This site collects results on the game, each with a paper, an
    illustrated proof guide, and a proof checked in Lean 4 on one shared formal model
    of the game.
  </p>

  <figure class="game">
    <sag-board n="6" strategy="plus"></sag-board>
    <figcaption>
      Play against the plus rule. The bot moves first and explains each move;
      click a cell, or use the arrow keys and Enter. Switch to the table
      strategy to compare. Below 6 × 6 the tables play.
    </figcaption>
  </figure>

  <h2>Results</h2>
  {
    results.map((r) => (
      <article class="result">
        <h3>{r.title}</h3>
        <p>{r.statement}</p>
        <nav class="result-links" aria-label={`${r.title}: where to go`}>
          <a href={`${base}${r.slug}/`}>overview</a>
          <a href={`${base}downloads/${r.slug}.pdf`}>paper (PDF)</a>
          <a href={`${base}${r.slug}/proof/`}>proof guide</a>
          <a href={`${base}downloads/square-achievement-formalization.tar.gz`}>
            Lean ({r.lean})
          </a>
        </nav>
      </article>
    ))
  }

  <h2>Open questions</h2>
  <p>
    The plus rule wins by ply 17 on every board, while per-size searches find
    wins within 13 plies: how quickly can the first player force a win on the
    <span set:html={k("n \\times n")} /> board, and can one strategy be fastest for
    every <span set:html={k("n")} />? The rule's second move has seven
    exceptions; is there an opening that needs none? Are the constants of the
    proofs, the 6 × 6 plan region and the 17 × 17 base board, least? And 5 × 5,
    where no purely forcing strategy exists, still has no short rule.
  </p>
</Base>
